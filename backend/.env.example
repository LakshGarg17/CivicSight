# CivicSight Backend Environment Configuration
PROJECT_NAME="CivicSight API"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite)
# For SQLite development: sqlite:///./civicsight.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/civicsight_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicsight_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicsight_db

# Authentication & JWT Configuration
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Priority Engine & Proximity Settings
NEARBY_DISTANCE_METERS=50.0
DUPLICATE_DISTANCE_METERS=15.0
DUPLICATE_TIME_WINDOW_DAYS=null
IMAGE_SIMILARITY_ENABLED=False
PRIORITY_MIN_CONFIDENCE=0.25
PRIORITY_HIGH_SEVERITY_THRESHOLD=0.55
PRIORITY_MEDIUM_SEVERITY_THRESHOLD=0.28
PRIORITY_HIGH_SCORE_THRESHOLD=60.0
PRIORITY_MEDIUM_SCORE_THRESHOLD=30.0
PRIORITY_HIGH_NEARBY_COUNT=4
PRIORITY_MEDIUM_NEARBY_COUNT=2
