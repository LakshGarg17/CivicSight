# CivicSight Backend Environment Configuration
PROJECT_NAME="CivicSight API"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite)
# For SQLite development: sqlite:///./civicsight.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/civicsight_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicsight_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicsight_db

# Authentication & JWT Configuration
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000"

# Priority Engine & Proximity Settings
NEARBY_DISTANCE_METERS=50.0
DUPLICATE_DISTANCE_METERS=15.0
DUPLICATE_TIME_WINDOW_DAYS=null
IMAGE_SIMILARITY_ENABLED=False
PRIORITY_MIN_CONFIDENCE=0.25
PRIORITY_HIGH_SEVERITY_THRESHOLD=0.55
PRIORITY_MEDIUM_SEVERITY_THRESHOLD=0.28
PRIORITY_HIGH_SCORE_THRESHOLD=60.0
PRIORITY_MEDIUM_SCORE_THRESHOLD=30.0
PRIORITY_HIGH_NEARBY_COUNT=4
PRIORITY_MEDIUM_NEARBY_COUNT=2

# ML Model Configuration (Full RDD2022 YOLOv8s)
MODEL_PATH="ml/runs/detect/clean_rdd2022_yolov8s/weights/best.pt"
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45
DETECTION_IMGSZ=640

# Frontend Google Maps Platform Configuration (Place in frontend/js/config.local.js or frontend/.env)
# 1. Google Cloud Console > Credentials: Create an API key with Maps JavaScript API & Geocoding API enabled.
# 2. Restrict key by HTTP referrer for localhost/domain and restrict APIs.
# 3. Create a Map ID under Google Maps Platform > Map Management (required for AdvancedMarkerElement).
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
GOOGLE_MAPS_MAP_ID="YOUR_GOOGLE_MAPS_MAP_ID"
